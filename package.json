{
  "name": "faraz",
  "version": "1.0.0",
  "private": true,
  "description": "Faraz portfolio - fullstack monorepo (React frontend + Flask backend)",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "setup": "npm install && python -m venv backend/venv && backend/venv/Scripts/python.exe -m pip install -r backend/requirements.txt",
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "backend/venv/Scripts/python.exe backend/run.py",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run dev:backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}